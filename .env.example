# Copy to .env (gitignored) and fill in.
DB_PASSWORD=change-me-to-a-long-random-string
# Image tag to run. 0.1.x is the old MongoDB release and does not work with this file.
BASTIONVAULT_VERSION=0.2
# true when served over HTTPS (e.g. behind Traefik)
VAULT_COOKIE_SECURE=false
# Regex of proxy addresses allowed to set X-Forwarded-For (Traefik).
VAULT_TRUSTED_PROXIES=127\.0\.0\.1
# Path inside the container to the auto-unseal key file (optional).
VAULT_UNSEAL_KEY_FILE=
